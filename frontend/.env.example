# Copy to .env.local for development. Set the same variables in the Vercel
# project settings for deployment.

# mock | live
#
# mock intercepts every request in the browser with MSW, so no backend is
# needed and the whole app works offline. live sends them to the Next server,
# which rewrites /api/* to API_ORIGIN.
#
# Accounts and password reset are live-only: a service worker cannot reproduce
# httpOnly cookies, CSRF tokens or refresh rotation, so mocking them would be a
# different mechanism wearing the same screens.
NEXT_PUBLIC_API_MODE=mock

# Where the Next server forwards /api/* when NEXT_PUBLIC_API_MODE=live.
#
# Server-side, deliberately not NEXT_PUBLIC_: the browser never needs to know
# where the API lives. It only ever talks to its own origin, which is what
# makes the session cookie first-party. Safari and Chrome both block
# third-party cookies, so a cookie set directly by onrender.com would be
# dropped on a vercel.app page.
API_ORIGIN=http://localhost:8082

# Nothing about email belongs here. RESET_LINK_BASE points at this app's
# /reset-password route but is read by the backend, which is what writes the
# link into the message.
